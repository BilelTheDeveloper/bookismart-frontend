# ═══════════════════════════════════════════════════════════════════
# BOOKIIFY — CLIENT ENVIRONMENT VARIABLES
# Copy this file to .env (or .env.local for local-only overrides).
# All VITE_ vars are embedded into the JS bundle at build time.
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# 1. API
# ───────────────────────────────────────────────────────────────────
VITE_API_URL=https://bookismart-backend-kcnn.onrender.com/api
# For local dev: VITE_API_URL=http://localhost:5000/api

# ───────────────────────────────────────────────────────────────────
# 2. MULTI-LANGUAGE (i18n)
#    Supported: fr (Français), ar (العربية), en (English)
#    When enabled, a LanguageSwitcher component appears in the navbar.
#    Arabic auto-enables RTL layout.
# ───────────────────────────────────────────────────────────────────
VITE_I18N_ENABLED=false                     # [FEATURE FLAG] set true to enable language picker

# ───────────────────────────────────────────────────────────────────
# 3. PWA — Progressive Web App
#    When enabled, Vite generates a service worker + manifest.
#    Users can "Add to Home Screen" on mobile (works like a native app).
#    Requires icon files in /public/icons/ (icon-192.png, icon-512.png)
#    Requires vite-plugin-pwa installed:
#      npm install vite-plugin-pwa workbox-window --save-dev
# ───────────────────────────────────────────────────────────────────
VITE_PWA_ENABLED=false                      # [FEATURE FLAG] set true to enable PWA

# ───────────────────────────────────────────────────────────────────
# 4. APP CONFIG (OPTIONAL)
# ───────────────────────────────────────────────────────────────────
VITE_APP_NAME=Bookiify
VITE_DEFAULT_LANG=fr                        # fr | ar | en (initial language if I18N is off)
